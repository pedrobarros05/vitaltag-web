{
  "name": "vitaltag-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:mock": "node mock-api/dev.mjs",
    "mock": "node mock-api/server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:mock": "node --test mock-api/server.test.mjs",
    "test:e2e": "playwright test",
    "test:all": "npm run test:mock && npm test && npm run test:e2e",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "lint": "next lint --dir app --dir components --dir lib --dir types --dir tests --dir mock-api"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.77.0",
    "next": "15.5.29",
    "react": "~19.0.9",
    "react-dom": "~19.0.9"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "~7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.0.0",
    "@types/react-dom": "~19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "eslint-config-next": "15.5.29",
    "jsdom": "^31.0.1",
    "postcss": "8.5.33",
    "qrcode": "^1.5.4",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "postcss": "8.5.33"
  }
}
